{
  "name": "warrior-code",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=@warrior-code/website",
    "build:website": "npm run build --workspace=@warrior-code/website",
    "deploy:website": "npm run build:website && wrangler pages deploy apps/website/dist --project-name warrior-code"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}